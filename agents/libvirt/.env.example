HUY_AGENT_TOKEN=change-me-in-production
# Optional extra tokens (comma-separated); or put several tokens in HUY_AGENT_TOKEN
# HUY_AGENT_TOKENS=ci-token,monitoring-token
# off | basic | schema (default; requires cloud-init OS package — see requirements-host.txt)
HUY_CLOUD_INIT_VALIDATION=schema
HUY_AGENT_COUNTRY=NL
HUY_AGENT_CITY=Amsterdam
HUY_AGENT_COMPANY=Huygens
HUY_DATA_DIR=/var/lib/huy-libvirt-agent
LIBVIRT_URI=qemu:///system
HUY_LIBVIRT_QUEUE_WORKERS=1
HUY_LIBVIRT_QUEUE_MAX_PENDING=64
HUY_LIBVIRT_QUEUE_TIMEOUT_SECONDS=300
# Read path (list/state/metrics) — separate queue so polls do not block on writes
HUY_LIBVIRT_READ_QUEUE_WORKERS=2
HUY_LIBVIRT_READ_QUEUE_MAX_PENDING=64
HUY_LIBVIRT_READ_QUEUE_TIMEOUT_SECONDS=120
HUY_STATUS_POLL_SECONDS=30
HUY_LOG_LEVEL=INFO
HUY_EVENT_BUS=file
HUY_DOCS_ENABLED=true
HUY_BIND_HOST=127.0.0.1
HUY_BIND_PORT=8765
# Optional: explicit Swagger server URL (else same-origin when BIND_HOST=0.0.0.0)
# HUY_PUBLIC_BASE_URL=https://dommel.kaposi.net:8765
# HUY_CORS_ORIGINS=https://app.example.com
HUY_TLS_ENABLED=false
HUY_TLS_AUTO_GENERATE=true
# HUY_TLS_REGENERATE=true
# HUY_TLS_CERT_DIR=/var/lib/huy-libvirt-agent/tls
