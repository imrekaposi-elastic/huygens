# Copy to .env in the repo root for Docker Compose:
#   cp compose.env.example .env

# PostgreSQL
POSTGRES_USER=huy
POSTGRES_PASSWORD=huy
POSTGRES_DB=huy

# IAM (Phase 1a)
JWT_SECRET=dev-jwt-secret-change-me-minimum-32-chars
JWT_ISSUER=huy-iam
BOOTSTRAP_ADMIN_USERNAME=platform-admin
BOOTSTRAP_ADMIN_PASSWORD=platform-admin-dev
BOOTSTRAP_ADMIN_EMAIL=platform-admin@example.com

# Phase 2 — Keycloak SSO (enable with: docker compose --profile sso up)
# OIDC_ENABLED=true
# OIDC_ISSUER=http://keycloak:8080/realms/huygens
# OIDC_CLIENT_SECRET=huy-iam-dev-secret
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin

# Registry + inventory + projects (Phase 1/3) — tokens must match across services
AGENT_TOKEN_ENCRYPTION_KEY=dev-agent-token-encryption-key-change-me
DEFAULT_SSH_LINUX_USERNAME=huygens
PROJECTS_SERVICE_TOKEN=dev-projects-service-token
BREAKOUT_SERVICE_TOKEN=dev-breakout-service-token
IAM_SERVICE_TOKEN=dev-iam-service-token
INVENTORY_SERVICE_TOKEN=dev-inventory-service-token
SSH_GATEWAY_SERVICE_TOKEN=dev-ssh-gateway-service-token
SSH_CA_ENCRYPTION_KEY=dev-ssh-ca-encryption-key-change-me-32

# Kafka (required in default docker compose stack)
KAFKA_BOOTSTRAP=kafka:9092
# Cluster example: KAFKA_BOOTSTRAP=kafka-1:9092,kafka-2:9092,kafka-3:9092

# Inventory / projects / compliance / iam / registry: set false only for unit tests without a broker
# KAFKA_PUBLISH_ENABLED=true

# Observability profile (optional): docker compose --profile observability up -d --build
# See docs/operations/observability-stack.md
# Latest Elastic 9.4 stack (Elasticsearch, Kibana, Logstash) — observability profile
ELASTIC_STACK_VERSION=9.4.1
# EDOT Collector version (align with ELASTIC_STACK_VERSION for local dev)
EDOT_COLLECTOR_VERSION=9.4.1
# Dev Elasticsearch/Kibana login (elastic user). Required for Streams/Observability in Kibana 9.
ELASTIC_PASSWORD=changeme-dev-only
# Production / secured Elasticsearch — API key for elasticsearch/otel exporter (optional if using ELASTIC_PASSWORD)
# ELASTIC_API_KEY=

# OpenTelemetry (Phase 8) — enable when using --profile observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SDK_DISABLED=false

# Per-service names (set on each container in Compose)
# OTEL_SERVICE_NAME=huy-registry   # iam | inventory | projects | compliance | huy-libvirt-agent
# OTEL_RESOURCE_ATTRIBUTES=huy.org.id=<uuid>
# Service map dependency labels (compliance S3 → SeaweedFS by default)
# OTEL_PEER_OBJECT_STORE_SERVICE_NAME=seaweedfs

# Application topics (huy.*) are created by the kafka-init Compose service.
# Optional overrides:
# KAFKA_TOPIC_PARTITIONS=1
# KAFKA_TOPIC_REPLICATION_FACTOR=1

# Compliance object store (dev default: SeaweedFS S3)
OBJECT_STORE_KIND=s3
OBJECT_STORE_BUCKET=huygens-dev
OBJECT_STORE_ENDPOINT=http://seaweed-s3:8333
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY_ID=huy-dev-access-key
OBJECT_STORE_SECRET_ACCESS_KEY=huy-dev-secret-key
OBJECT_STORE_PREFIX=huy-compliance
