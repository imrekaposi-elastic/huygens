# PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://huy:huy@localhost:5432/huy_iam

# Local development (default)
DATABASE_URL=sqlite+aiosqlite:///./data/huy-iam.db

JWT_SECRET=change-me-in-production
JWT_ISSUER=huy-iam
JWT_ACCESS_TTL_SECONDS=3600

BOOTSTRAP_ADMIN_USERNAME=platform-admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-bootstrap
BOOTSTRAP_ADMIN_EMAIL=platform-admin@example.com

HUY_IAM_HOST=127.0.0.1
HUY_IAM_PORT=8081

# Phase 2 — Keycloak OIDC (optional)
OIDC_ENABLED=false
OIDC_ISSUER=http://127.0.0.1:8080/realms/huygens
OIDC_REALM=huygens
OIDC_CLIENT_ID=huy-iam
OIDC_CLIENT_SECRET=huy-iam-dev-secret
OIDC_REDIRECT_URI=http://127.0.0.1:8081/api/v1/auth/oidc/callback
