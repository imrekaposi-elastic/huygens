{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huygens.dev/schemas/kafka/audit-event.schema.json",
  "title": "HuygensAuditEventData",
  "description": "CloudEvents data payload for huy.audit.events (ECS-aligned fields)",
  "type": "object",
  "required": ["version", "organization_id", "action", "outcome", "timestamp"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "organization_id": { "type": "string", "format": "uuid" },
    "user_id": { "type": "string" },
    "user": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "roles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "action": { "type": "string" },
    "outcome": { "type": "string", "enum": ["success", "failure", "unknown"] },
    "timestamp": { "type": "string", "format": "date-time" },
    "resource": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "id": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "message": { "type": "string" },
    "trace_id": { "type": "string" },
    "labels": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "additionalProperties": true
}
